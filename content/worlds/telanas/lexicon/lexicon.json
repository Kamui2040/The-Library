      },
      "labels": {
        "en": {
          "title": "Nessa",
          "summary": "Eryn's grandmother, the village's oldest resident, and an outspoken elder deeply woven into village life."
        },
        "de": {
          "title": "Nessa",
          "summary": "Eryns Großmutter, die älteste Bewohnerin des Dorfes und eine scharfzüngige Älteste, die tief zum Dorfleben gehört."
        }
      },
      "fragments": [
        {
          "id": "nessa-dies",
          "visibility": {
            "mode": "reached-anchor",
            "story": "dragon-knight",
            "book": "volume-01",
            "anchor": "dk-v01-ch08-nessa-dies",
            "chapter": "dk-v01-ch08"
          },
          "text": {
            "en": "Nessa dies in the first week of spring. At her burial, villagers remember a harvest she organized during the war, help she gave several households through a hard winter, and everyday knowledge that continued after her.",
            "de": "Nessa stirbt in der ersten Frühlingswoche. Bei ihrer Beerdigung erinnern sich die Dorfbewohner an eine von ihr organisierte Ernte während des Krieges, an ihre Hilfe für mehrere Haushalte in einem harten Winter und an alltägliches Wissen, das nach ihr weiterlebt."
          },
          "readerLinks": [
            {
              "id": "nessa-dies-reader",
              "story": "dragon-knight",
              "book": "volume-01",
              "anchor": "dk-v01-ch08-nessa-dies",
