      "labels": {
        "en": {
          "title": "Calist",
          "summary": "A young villager who grows up around his father's forge, fascinated by stories from the roads beyond home."
        },
        "de": {
          "title": "Calist",
          "summary": "Ein junger Dorfbewohner, der rund um die Schmiede seines Vaters aufwächst und von Geschichten über die Welt jenseits seines Zuhauses fasziniert ist."
        }
      },
      "fragments": [
        {
          "id": "calist-beyond-home",
          "visibility": {
            "mode": "reached-anchor",
            "story": "dragon-knight",
            "book": "volume-01",
            "anchor": "dk-v01-ch01-corvin-arrives",
            "chapter": "dk-v01-ch01"
          },
          "text": {
            "en": "Visiting soldiers fascinate Calist less for stories of fighting than for the roads, towns, rivers, and unfamiliar places they have seen.",
            "de": "Durchreisende Soldaten faszinieren Calist weniger wegen der Kämpfe als wegen ihrer Erzählungen über Straßen, Städte, Flüsse und unbekannte Orte."
          },
          "readerLinks": [
            {
              "id": "calist-beyond-home-reader",
              "story": "dragon-knight",
              "book": "volume-01",
              "anchor": "dk-v01-ch01-corvin-arrives",
              "labels": {
                "en": "Open the related passage",
                "de": "Zugehörige Stelle öffnen"
              }
            }
          ]
        },
        {
          "id": "calist-useful-hands",
          "visibility": {
            "mode": "reached-anchor",
            "story": "dragon-knight",
            "book": "volume-01",
            "anchor": "dk-v01-ch04-first-independent-work",
            "chapter": "dk-v01-ch04"
          },
          "text": {
            "en": "Under Alden's teaching, Calist grows from fetching tools and carrying loads into making and repairing practical things people can trust.",
            "de": "Unter Aldens Anleitung wird Calist vom Helfer, der Werkzeuge holt und Lasten trägt, zu jemandem, der praktische Dinge selbst herstellt und repariert."
          },
          "readerLinks": [
            {
              "id": "calist-useful-hands-reader",
              "story": "dragon-knight",
              "book": "volume-01",
              "anchor": "dk-v01-ch04-first-independent-work",
              "labels": {
                "en": "Open the related passage",
                "de": "Zugehörige Stelle öffnen"
              }
            }
          ]
        },
        {
          "id": "calist-bram-apprentice",
          "visibility": {
            "mode": "reached-anchor",
            "story": "dragon-knight",
            "book": "volume-01",
            "anchor": "dk-v01-ch06-apprentice-moves",
            "chapter": "dk-v01-ch06"
          },
          "text": {
            "en": "Bram takes Calist on as an apprentice in fine metalwork, giving him a different kind of craft to learn from the village forge.",
            "de": "Bram nimmt Calist als Lehrling für Feinmetallarbeit auf und bringt ihm ein anderes Handwerk bei als Aldens Dorfschmiede."
          },
          "readerLinks": [
            {
              "id": "calist-bram-apprentice-reader",
              "story": "dragon-knight",
              "book": "volume-01",
              "anchor": "dk-v01-ch06-apprentice-moves",
              "labels": {
                "en": "Open the related passage",
                "de": "Zugehörige Stelle öffnen"
              }
            }
          ]
        },
        {
          "id": "calist-learns-letters",
          "visibility": {
            "mode": "reached-anchor",
            "story": "dragon-knight",
            "book": "volume-01",
            "anchor": "dk-v01-ch06-first-letter",
            "chapter": "dk-v01-ch06"
          },
          "text": {
            "en": "Because Bram receives written orders, Calist begins learning to read and write through labels, measurements, customer notes, and everyday workshop work.",
            "de": "Weil Bram schriftliche Aufträge erhält, beginnt Calist anhand von Beschriftungen, Maßen, Kundennotizen und alltäglicher Werkstattarbeit lesen und schreiben zu lernen."
          },
          "readerLinks": [
            {
              "id": "calist-learns-letters-reader",
              "story": "dragon-knight",
              "book": "volume-01",
              "anchor": "dk-v01-ch06-first-letter",
              "labels": {
                "en": "Open the related passage",
                "de": "Zugehörige Stelle öffnen"
              }
            }
          ]
        },
        {
          "id": "calist-necklace-grief",
          "visibility": {
            "mode": "reached-anchor",
            "story": "dragon-knight",
            "book": "volume-01",
            "anchor": "dk-v01-ch08-necklace-grief",
            "chapter": "dk-v01-ch08"
          },
          "text": {
            "en": "Calist finishes a silver leaf-and-arrow necklace for Eryn but never gives it to her. After her disappearance, the finished gift becomes a painful reminder of all the times he believed there would still be another chance.",
            "de": "Calist fertigt für Eryn eine silberne Halskette mit Blatt und Pfeil, gibt sie ihr aber nie. Nach ihrem Verschwinden wird das fertige Geschenk zu einer schmerzhaften Erinnerung an all die Male, in denen er glaubte, es würde noch eine weitere Gelegenheit geben."
          },
          "readerLinks": [
            {
              "id": "calist-necklace-grief-reader",
              "story": "dragon-knight",
              "book": "volume-01",
              "anchor": "dk-v01-ch08-necklace-grief",
              "labels": {
                "en": "Open the related passage",
                "de": "Zugehörige Stelle öffnen"
              }
            }
          ]
        },
        {
          "id": "calist-enlists",
          "visibility": {
            "mode": "reached-anchor",
            "story": "dragon-knight",
            "book": "volume-01",
            "anchor": "dk-v01-ch09-enlist-decision",
            "chapter": "dk-v01-ch09"
          },
          "text": {
            "en": "Calist decides to enlist because he wants the ordinary life of his village to remain possible for the people who live there.",
            "de": "Calist entscheidet sich für den Militärdienst, weil das gewöhnliche Leben seines Dorfes für die Menschen dort weiter möglich bleiben soll."
          },
          "readerLinks": [
            {
              "id": "calist-enlists-reader",
