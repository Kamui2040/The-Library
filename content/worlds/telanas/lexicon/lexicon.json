        {
          "id": "eryn-experienced-hunter",
          "visibility": {
            "mode": "reached-anchor",
            "story": "dragon-knight",
            "book": "volume-01",
            "anchor": "dk-v01-ch08-hunters-depart",
            "chapter": "dk-v01-ch08"
          },
          "text": {
            "en": "By adulthood, Eryn is no longer being taken hunting merely to learn; younger hunters sometimes come to her with questions.",
            "de": "Als junge Erwachsene wird Eryn nicht mehr nur mitgenommen, um zu lernen; jüngere Jäger kommen inzwischen mit Fragen zu ihr."
          },
          "readerLinks": [
            {
              "id": "eryn-experienced-hunter-reader",
