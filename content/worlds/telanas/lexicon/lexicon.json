      "labels": {
        "en": {
          "title": "Eryn",
          "summary": "Calist's close childhood friend, at home with bows, hunting gear, and the practical work of the village."
        },
        "de": {
          "title": "Eryn",
          "summary": "Calists enge Freundin aus Kindertagen, die mit Bögen, Jagdausrüstung und der praktischen Arbeit des Dorfes vertraut ist."
        }
      },
      "fragments": [
        {
          "id": "eryn-hunter",
          "visibility": {
            "mode": "reached-anchor",
            "story": "dragon-knight",
            "book": "volume-01",
            "anchor": "dk-v01-ch05-camp",
            "chapter": "dk-v01-ch05"
          },
          "text": {
            "en": "Eryn hunts with Harlan, Bren, and other experienced villagers. She treats danger practically and knows when responsibility for a decision belongs to someone more experienced.",
            "de": "Eryn jagt mit Harlan, Bren und anderen erfahrenen Dorfbewohnern. Sie begegnet Gefahr nüchtern und weiß, wann die Verantwortung für eine Entscheidung bei jemandem mit mehr Erfahrung liegt."
          },
          "readerLinks": [
            {
              "id": "eryn-hunter-reader",
              "story": "dragon-knight",
              "book": "volume-01",
              "anchor": "dk-v01-ch05-camp",
