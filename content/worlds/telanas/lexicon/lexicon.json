          "visibility": {
            "mode": "reached-anchor",
            "story": "dragon-knight",
            "book": "volume-01",
            "anchor": "dk-v01-ch08-ambush-return",
            "chapter": "dk-v01-ch08"
          },
          "text": {
            "en": "During an ambush, Eryn initially retreats with the injured survivors but turns back after Bren stays behind.",
            "de": "Bei einem Hinterhalt zieht Eryn zunächst mit den verletzten Überlebenden zurück, kehrt dann aber um, nachdem Bren zurückbleibt."
          },
          "readerLinks": [
            {
              "id": "eryn-turns-back-reader",
